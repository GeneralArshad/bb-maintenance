{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 503,
      "headers": {
        "Retry-After": "604800",
        "Cache-Control": "no-store, max-age=0",
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}
